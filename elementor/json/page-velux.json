                  "sizes": []
                }
              },
              "elements": [
                {
                  "id": "e5d7c7c0",
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "title": "Exemples de chantiers",
                    "header_size": "h2",
                    "title_color": "#1C1612",
                    "align": "start"
                  },
                  "elements": []
                },
                {
                  "id": "a1fc687b",
                  "elType": "widget",
                  "widgetType": "text-editor",
                  "settings": {
                    "editor": "<ul><li>Transformation d’un débarras en chambre et réalisation de chevrette de panne pour pose d’un Velux.</li><li>Aile droite : agrandissement d’un Velux 114 × 118 cm en jumelage après réfection totale de toiture ; aile gauche : changement de Velux. Isolation par l’extérieur en laine de bois 2 × 120 mm croisées, R = 6,30.</li><li>Création de Velux en duo 134 × 140 cm ainsi que 134 × 98 cm.</li></ul>",
                    "text_color": "#1C1612",
                    "align": "start"
                  },
                  "elements": []
                }
              ]
            }
          ]
        }
      ]
