                  "elements": []
                },
                {
                  "id": "f5bd1b52",
                  "elType": "widget",
                  "widgetType": "text-editor",
                  "settings": {
                    "editor": "<p><strong>SCHUBERT Eric</strong> dirige l’entreprise, spécialisée dans la réfection de toiture, l’isolation de toiture et de comble non aménageable.</p><p>Plus de 20 ans d’expérience en <strong>zinguerie, charpente, sarking et Velux</strong>. Les supports de couverture : tuiles, tuiles écailles, bac acier, ardoise et joints debout.</p><p>Les travaux sont réalisés dans le respect des normes <strong>DTU</strong> et <strong>CSTB</strong>.</p>",
                    "text_color": "#1C1612",
                    "align": "start"
                  },
                  "elements": []
                }
              ]
            },
