        {
          "id": "4ef07159",
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "<p>À partir d’une résistance thermique de <strong>7</strong> (ligne mise en avant), l’épaisseur après tassement est de 315 mm.</p>",
            "text_color": "#1C1612",
            "align": "start"
          },
          "elements": []
        },
        {
          "id": "373ce576",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "\n<table>\n<thead><tr><th>Ép. (mm)</th><th>Ép. après tassement (mm)</th><th>R (m².K/W)</th><th>Pouvoir couvrant (kg/m²)</th><th>Sacs / 100 m²</th><th>Up (W/m².K)</th></tr></thead>\n<tbody>\n<tr><td>95</td><td>90</td><td>2</td><td>2</td><td>9,6</td><td></td></tr>\n<tr><td>230</td><td>225</td><td>5</td><td>4,9</td><td>24,1</td><td>0,2</td></tr>\n<tr><td>275</td><td>270</td><td>6</td><td>5,8</td><td>28,9</td><td>0,16</td></tr>\n<tr><td>320</td><td>315</td><td>7</td><td>6,8</td><td>33,2</td><td>0,14</td></tr>\n<tr><td>365</td><td>360</td><td>8</td><td>7,8</td><td>38,5</td><td>0,12</td></tr>\n<tr><td>410</td><td>405</td><td>9</td><td>8,7</td><td>43,4</td><td></td></tr>\n<tr><td>455</td><td>450</td><td>10</td><td>9,7</td><td>48,2</td><td></td></tr>\n<tr><td>500</td><td>495</td><td>11</td><td>10,6</td><td>53</td><td></td></tr>\n<tr><td>545</td><td>540</td><td>12</td><td>11,6</td><td>57,8</td><td></td></tr>\n<tr><td>595</td><td>585</td><td>13</td><td>12,6</td><td>62,6</td><td></td></tr>\n<tr><td>640</td><td>630</td><td>14</td><td>13,5</td><td>67,5</td><td></td></tr>\n<tr><td>685</td><td>675</td><td>15</td><td>14,5</td><td>72,3</td><td></td></tr>\n</tbody>\n</table>\n"
          },
          "elements": []
        }
      ]
